# Copy to .env for local use. Never commit .env -- it's in .gitignore already.
# On Render, these are set as dashboard environment variables instead of a
# file; see README "Deploying to Render".

MLFLOW_TRACKING_URI=./mlruns
MLFLOW_EXPERIMENT=telco-churn
REGISTERED_MODEL_NAME=telco-churn-classifier
PRODUCTION_ALIAS=champion

# Set this to serve from the registry instead of the baked-in joblib:
# MLFLOW_MODEL_URI=models:/telco-churn-classifier@champion
MODEL_VERSION=local

# Read by the Dockerfile's CMD (gunicorn --bind 0.0.0.0:$PORT --workers $WORKERS).
# Render sets PORT itself; WORKERS defaults to 2, but the free Render plan's
# 512MB RAM fits one worker more safely -- see render.yaml.
PORT=8000
WORKERS=2

# AWS -- only used by deploy/ scripts and the optional AWS job in
# .github/workflows/ci-cd.yml. Not required for the Render deployment.
AWS_REGION=ap-south-1
ECR_REPOSITORY=telco-churn-api

# Hugging Face Spaces -- only used by deploy/huggingface/deploy_to_spaces.py.
# Not required for the Render deployment.
# HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxx
