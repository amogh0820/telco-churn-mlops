# Data and model artifacts are reproducible -- with one deliberate exception.
data/raw/*
data/processed/*
!data/**/.gitkeep

# The trained pipeline IS committed (see the two !-rules below), even though
# everything else generated by training is not. Render builds this project's
# Docker image directly from a git checkout with no training step of its own
# -- COPY artifacts/model.joblib in the Dockerfile needs the file to already
# be in the repo, or the image build fails. Run `make train` and `git add`
# these two files before pushing; see README "Deploying" for the full reason.
artifacts/*
!artifacts/.gitkeep
!artifacts/model.joblib
!artifacts/model_metadata.json

reports/*
!reports/.gitkeep
mlruns/
mlflow-db/*
!mlflow-db/.gitkeep

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/
*.egg-info/
node_modules/

# Secrets and credentials -- never committed, under any name.
.env
.env.*
!.env.example
*.pem
*.key
*credentials*
*secret*
*token*
!package-lock.json
!**/package-lock.json

# Env and editors
.DS_Store
.idea/
.vscode/
